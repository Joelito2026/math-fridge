EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_API_BASE_URL=http://your-backend-host:8000/api
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-publishable-key
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
# Add frontend://**, your local/deployed /auth/callback URL, and your
# local/deployed /auth/reset-password URL to
# Supabase Authentication > URL Configuration > Redirect URLs.
